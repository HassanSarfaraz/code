================================================================================
LAB 3 — ORDER BY / GROUP BY / HAVING
================================================================================

--- GROUP BY ---
SELECT col1, AGG_FUNC(col2)
FROM table
GROUP BY col1;

Examples:
  SELECT customer_id, SUM(amount) FROM payment GROUP BY customer_id;
  SELECT staff_id, COUNT(payment_id) FROM payment GROUP BY staff_id;
  SELECT customer_id, staff_id, SUM(amount) FROM payment GROUP BY staff_id, customer_id ORDER BY customer_id;
  SELECT DATE(payment_date) paid_date, SUM(amount) FROM payment GROUP BY DATE(payment_date);

--- HAVING ---
SELECT col1, AGG_FUNC(col2)
FROM table
GROUP BY col1
HAVING condition;

Example:
  SELECT customer_id, SUM(amount) FROM payment
  GROUP BY customer_id
  HAVING SUM(amount) > 200;

WHERE vs HAVING:
  WHERE  → filters rows BEFORE grouping  (no aggregates allowed)
  HAVING → filters groups AFTER grouping (aggregates allowed)

--- ORDER BY ---
SELECT select_list FROM table
ORDER BY expr1 [ASC|DESC], expr2 [ASC|DESC];

  ASC  = A→Z, 1→9 (default)
  DESC = Z→A, 9→1

Examples:
  SELECT first_name, last_name FROM customer ORDER BY first_name ASC;
  SELECT first_name, last_name FROM customer ORDER BY last_name DESC;
  SELECT first_name, last_name FROM customer ORDER BY first_name ASC, last_name DESC;

Execution order: FROM → WHERE → GROUP BY → HAVING → SELECT → ORDER BY → LIMIT


================================================================================
LAB 4 — CONSTRAINTS
================================================================================

--- CONSTRAINT TYPES ---
NOT NULL    → column must always have a value
UNIQUE      → all values in column must be distinct
PRIMARY KEY → NOT NULL + UNIQUE, uniquely identifies each row
FOREIGN KEY → references PK in another table (referential integrity)
CHECK       → value must satisfy a boolean expression

--- PRIMARY KEY ---
-- Single column:
CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT);

-- Composite:
CREATE TABLE t (col1 INT, col2 INT, data TEXT, PRIMARY KEY (col1, col2));

-- Named:
CONSTRAINT pk_name PRIMARY KEY (col1, col2)

-- Add to existing table:
ALTER TABLE products ADD PRIMARY KEY (product_no);

-- Auto-increment PK on existing table:
ALTER TABLE vendors ADD COLUMN id SERIAL PRIMARY KEY;

-- Remove:
ALTER TABLE products DROP CONSTRAINT products_pkey;

--- FOREIGN KEY ---
CREATE TABLE child (
    id INT PRIMARY KEY,
    parent_id INT,
    CONSTRAINT fk_name
        FOREIGN KEY (parent_id)
        REFERENCES parent_table(parent_id_col)
        [ON DELETE CASCADE | SET NULL | SET DEFAULT | RESTRICT | NO ACTION]
);

-- Add to existing table:
ALTER TABLE child ADD CONSTRAINT fk_name FOREIGN KEY (col) REFERENCES parent(col);

-- Drop then re-add with CASCADE:
ALTER TABLE child DROP CONSTRAINT fk_name;
ALTER TABLE child ADD CONSTRAINT fk_name FOREIGN KEY (col) REFERENCES parent(col) ON DELETE CASCADE;

ON DELETE actions:
  NO ACTION  → error if child rows exist (default)
  CASCADE    → auto-delete child rows
  SET NULL   → set FK column to NULL
  SET DEFAULT → set FK column to default value
  RESTRICT   → immediately prevent deletion

--- CHECK ---
-- Inline:
salary NUMERIC CHECK(salary > 0)
birth_date DATE CHECK(birth_date > '1900-01-01')
joined_date DATE CHECK(joined_date > birth_date)

-- Named:
salary NUMERIC CONSTRAINT positive_salary CHECK(salary > 0)

-- Add to existing table:
ALTER TABLE prices_list
ADD CONSTRAINT price_discount_check
CHECK (price > 0 AND discount >= 0 AND price > discount);

--- UNIQUE ---
-- Column-level:
email VARCHAR(50) UNIQUE

-- Table-level:
UNIQUE(email)

-- Multi-column unique:
UNIQUE(c2, c3)

-- Drop:
ALTER TABLE tbl DROP CONSTRAINT constraint_name;

--- NOT NULL ---
-- Declaration:
column_name data_type NOT NULL

-- Add to existing:
ALTER TABLE t ALTER COLUMN col SET NOT NULL;

-- Add to multiple:
ALTER TABLE t
    ALTER COLUMN c1 SET NOT NULL,
    ALTER COLUMN c2 SET NOT NULL;

-- Drop:
ALTER TABLE t ALTER COLUMN col DROP NOT NULL;

-- Either/or logic (at least one must be non-null):
CONSTRAINT name CHECK (
    NOT ((col1 IS NULL OR col1 = '') AND (col2 IS NULL OR col2 = ''))
)

NULL rules:
  NULL != NULL → NULL   (use IS NULL / IS NOT NULL to check)
  NULL = NULL  → NULL   (not TRUE)


================================================================================
LAB 5 — AGGREGATE FUNCTIONS & SUBQUERIES
================================================================================

--- AGGREGATE FUNCTIONS ---
AVG(col)        → average (use ROUND(AVG(col), 2) for decimals)
COUNT(*)        → count all rows
COUNT(col)      → count non-null values
MAX(col)        → maximum value
MIN(col)        → minimum value
SUM(col)        → total sum

STRING_AGG(col, separator [ORDER BY col ASC|DESC])
  → concatenates strings with separator

Examples:
  SELECT ROUND(AVG(replacement_cost), 2) FROM film;
  SELECT COUNT(*) FROM film;
  SELECT MAX(replacement_cost) FROM film;
  SELECT MIN(replacement_cost) FROM film;
  SELECT rating, SUM(rental_duration) FROM film GROUP BY rating ORDER BY rating;

  SELECT team_name, string_agg(player_name, ',') FROM players GROUP BY team_name;
  SELECT team_name, string_agg(player_name, ',' ORDER BY player_name ASC) FROM players GROUP BY team_name;

Aggregate functions only allowed in SELECT and HAVING clauses.

--- SUBQUERY GENERAL SYNTAX ---
SELECT ... FROM ... WHERE col OPERATOR (SELECT ... FROM ...);

Rules:
  - Must be enclosed in parentheses
  - Executes before outer query
  - Single-row subquery → use =, >, <, >=, <=, !=
  - Multi-row subquery → use IN, ANY, ALL, EXISTS

--- SCALAR SUBQUERY (returns 1 value) ---
SELECT first_name, last_name, salary FROM employees
WHERE salary > (SELECT MAX(salary) FROM employees WHERE first_name = 'Alexander');

--- ALL (condition must hold for every returned value) ---
SELECT department_id, AVG(SALARY)
FROM employees GROUP BY department_id
HAVING AVG(SALARY) >= ALL (SELECT AVG(SALARY) FROM employees GROUP BY department_id);

--- ANY / SOME (condition holds for at least one value) ---
-- IN = = ANY
SELECT first_name, last_name, department_id FROM employees
WHERE department_id = ANY (SELECT department_id FROM departments WHERE location_id = 1700);

--- IN ---
SELECT first_name, last_name FROM employees
WHERE department_id IN (SELECT department_id FROM departments WHERE location_id = 1800);

--- NOT IN ---
SELECT first_name, last_name FROM employees
WHERE department_id NOT IN (SELECT department_id FROM departments WHERE manager_id BETWEEN 100 AND 200);

--- EXISTS (true if subquery returns ≥1 row) ---
SELECT employee_id, first_name FROM employees E
WHERE EXISTS (SELECT * FROM employees WHERE manager_id = E.employee_id);

--- ROW SUBQUERY ---
SELECT first_name FROM employees
WHERE ROW(department_id, manager_id) = (SELECT department_id, manager_id FROM departments WHERE location_id = 1800);

--- SUBQUERY IN FROM (derived table) ---
SELECT AVG(sq_sum)
FROM (SELECT SUM(score) AS sq_sum FROM student GROUP BY name) AS t;


================================================================================
LAB 6 — JOINS
================================================================================

--- INNER JOIN (only matching rows) ---
SELECT * FROM table1
INNER JOIN table2 ON table1.col = table2.col;

Example:
  SELECT * FROM invoice INNER JOIN item ON invoice.item_no = item.item_no;
  SELECT * FROM invoice INNER JOIN item ON invoice.item_no = item.item_no WHERE item.rate >= 10;

--- LEFT OUTER JOIN (all from left, NULLs for unmatched right) ---
SELECT * FROM table1
LEFT [OUTER] JOIN table2 ON table1.col = table2.col;

Example:
  SELECT item.item_no, item_descrip, invoice.invoice_no, invoice.sold_qty
  FROM item LEFT JOIN invoice ON item.item_no = invoice.item_no;

--- RIGHT OUTER JOIN (all from right, NULLs for unmatched left) ---
SELECT * FROM table1
RIGHT [OUTER] JOIN table2 ON table1.col = table2.col;

--- FULL OUTER JOIN (all rows from both, NULLs where no match) ---
SELECT * FROM table1
FULL [OUTER] JOIN table2 ON table1.col = table2.col;

--- CROSS JOIN (cartesian product: rows1 × rows2) ---
SELECT * FROM table1 CROSS JOIN table2;
-- or --
SELECT * FROM table1, table2;

--- ANTI-JOIN (rows in left NOT in right) ---
SELECT * FROM Table_1 t1
LEFT JOIN Table_2 t2 ON t1.id = t2.id
WHERE t2.id IS NULL;

--- SEMI-JOIN (departments with at least one customer) ---
SELECT dept_id FROM departments
WHERE EXISTS (SELECT 1 FROM customer WHERE customer.dept_id = departments.dept_id);

--- SELF JOIN (table joins itself) ---
SELECT a.col, b.col FROM table a, table b WHERE a.field = b.field;

Example:
  SELECT a.name, b.age, a.SALARY FROM CUSTOMERS a, CUSTOMERS b WHERE a.SALARY < b.SALARY;

--- NATURAL JOIN (auto-joins on same-named columns) ---
SELECT * FROM T1 NATURAL [INNER | LEFT | RIGHT] JOIN T2;

--- EQUI JOIN (explicit = in WHERE) ---
SELECT col_list FROM t1, t2 WHERE t1.col = t2.col;
-- or --
SELECT * FROM t1 JOIN t2 ON (join_condition);

Join Summary:
  INNER JOIN   → matching rows only
  LEFT JOIN    → all left + matching right (NULL if no match)
  RIGHT JOIN   → all right + matching left (NULL if no match)
  FULL JOIN    → all rows both sides (NULL where no match)
  CROSS JOIN   → every combination (no ON clause)
  ANTI-JOIN    → left rows with NO right match (LEFT JOIN + IS NULL)
  SEMI-JOIN    → left rows where match EXISTS (one copy per match)
  SELF JOIN    → table joined to itself


================================================================================
LAB 7 — PL/pgSQL BLOCK STRUCTURE, IF/CASE/LOOPS
================================================================================

--- BLOCK STRUCTURE ---
[ <<label>> ]
[ DECLARE
    variable_name data_type := initial_value; ]
BEGIN
    statements;
END [ label ];

Anonymous block (run once):
  DO $$ DECLARE ... BEGIN ... END $$;

--- VARIABLE DECLARATION ---
  var_name INTEGER := 0;
  var_name film%rowtype;               -- row type of a table
  var_name film.film_id%type := 100;  -- same type as a column

--- RAISE NOTICE (print output) ---
  RAISE NOTICE 'Message: %', variable;   -- % is a placeholder

--- SELECT INTO ---
  SELECT col INTO variable FROM table WHERE condition;
  -- FOUND = true if row returned, false if not

--- IF-THEN ---
IF condition THEN
    statements;
END IF;

--- IF-THEN-ELSE ---
IF condition THEN
    statements;
ELSE
    alternative;
END IF;

--- IF-THEN-ELSIF ---
IF condition_1 THEN
    statements;
ELSIF condition_2 THEN
    statements;
ELSIF condition_n THEN
    statements;
ELSE
    else_statements;
END IF;

Example:
  IF v_film.length > 0 AND v_film.length <= 50 THEN
      len_description := 'Short';
  ELSIF v_film.length > 50 AND v_film.length < 120 THEN
      len_description := 'Medium';
  ELSIF v_film.length > 120 THEN
      len_description := 'Long';
  ELSE
      len_description := 'N/A';
  END IF;

--- SIMPLE CASE (match single expression) ---
CASE search_expression
    WHEN value1 THEN statements;
    WHEN value2 THEN statements;
    ELSE else_statements;
END CASE;

Example:
  CASE rate
      WHEN 0.99 THEN price_segment = 'Mass';
      WHEN 2.99 THEN price_segment = 'Mainstream';
      WHEN 4.99 THEN price_segment = 'High End';
      ELSE price_segment = 'Unspecified';
  END CASE;

--- SEARCHED CASE (boolean expressions) ---
CASE
    WHEN boolean_expr_1 THEN statements;
    WHEN boolean_expr_2 THEN statements;
    ELSE statements;
END CASE;

Example:
  CASE
      WHEN total_payment > 200 THEN service_level = 'Platinum';
      WHEN total_payment > 100 THEN service_level = 'Gold';
      ELSE service_level = 'Silver';
  END CASE;

--- WHILE LOOP (pretest: checks condition BEFORE each iteration) ---
WHILE condition LOOP
    statements;
END LOOP;

Example:
  DECLARE counter INTEGER := 0;
  WHILE counter < 5 LOOP
      RAISE NOTICE 'Counter %', counter;
      counter := counter + 1;
  END LOOP;
  -- Prints: Counter 0, 1, 2, 3, 4

--- UNCONDITIONAL LOOP (use EXIT to break) ---
<<label>>
LOOP
    statements;
    EXIT WHEN condition;   -- or: IF condition THEN EXIT; END IF;
END LOOP;

-- Nested loops:
<<outer>>
LOOP
    <<inner>>
    LOOP
        EXIT <<inner>> WHEN condition;  -- exits inner only
    END LOOP;
END LOOP;

Fibonacci example:
  LOOP
      EXIT WHEN counter = n;
      counter := counter + 1;
      SELECT j, i + j INTO i, j;  -- simultaneous swap
  END LOOP;


