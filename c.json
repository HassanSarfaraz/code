LAB 8 — CURSORS, FUNCTIONS, PROCEDURES
================================================================================

--- CURSORS ---
-- Declare:
DECLARE
    my_cursor REFCURSOR;
    cur_films CURSOR FOR SELECT * FROM film;
    cur_films2 CURSOR (year INTEGER) FOR SELECT * FROM film WHERE release_year = year;

-- Open:
    OPEN cur_films;
    OPEN cur_films2(year := 2005);

-- Fetch:
    FETCH cur_films INTO row_film;
    FETCH LAST FROM cur_films INTO title, release_year;
    -- Directions: NEXT, PRIOR, FIRST, LAST, ABSOLUTE n, RELATIVE n, FORWARD, BACKWARD

-- Close:
    CLOSE cur_films;

--- FUNCTIONS ---
CREATE [OR REPLACE] FUNCTION function_name(param1 type, param2 type)
RETURNS return_type
LANGUAGE plpgsql
AS $$
DECLARE
    local_var type;
BEGIN
    -- logic
    RETURN value;
END;
$$;

Full example:
  CREATE FUNCTION get_film_count(len_from INT, len_to INT)
  RETURNS INT
  LANGUAGE plpgsql AS $$
  DECLARE film_count INTEGER;
  BEGIN
      SELECT COUNT(*) INTO film_count FROM film WHERE length BETWEEN len_from AND len_to;
      RETURN film_count;
  END; $$;

-- Calling (3 ways):
  SELECT get_film_count(40, 90);                                          -- positional
  SELECT get_film_count(len_from => 40, len_to => 90);   -- named
  SELECT get_film_count(40, len_to => 90);               -- mixed

-- Note: named args use => or := (legacy)
-- Cannot put named args before positional args

--- STORED PROCEDURES ---
CREATE [OR REPLACE] PROCEDURE procedure_name(parameter_list)
LANGUAGE plpgsql
AS $$
DECLARE
    -- variables
BEGIN
    -- body
    COMMIT;  -- procedures CAN commit/rollback
END; $$;

-- Differences from functions:
  - No RETURN type (no RETURNS clause)
  - Cannot use: RETURN expression;
  - CAN use: RETURN;  (to stop early)
  - Parameters: IN or INOUT only (no OUT)
  - Called with CALL, not SELECT

-- Calling:
  CALL procedure_name(arg1, arg2);

Transfer example:
  CREATE OR REPLACE PROCEDURE transfer(sender INT, receiver INT, amount DEC)
  LANGUAGE plpgsql AS $$
  BEGIN
      UPDATE accounts SET balance = balance - amount WHERE id = sender;
      UPDATE accounts SET balance = balance + amount WHERE id = receiver;
      COMMIT;
  END; $$;

  CALL transfer(1, 2, 500);

Function vs Procedure:
  Functions  → return a value, called in SELECT, NO transaction control
  Procedures → no return value, called with CALL, CAN commit/rollback


================================================================================
LAB 9 — TRIGGERS, VIEWS, INDEXES
================================================================================

--- TRIGGERS ---
-- Step 1: Create trigger function
CREATE [OR REPLACE] FUNCTION function_name()
RETURNS TRIGGER
LANGUAGE PLPGSQL AS $$
BEGIN
    -- Use OLD (before) and NEW (after) row
    -- Return NEW for BEFORE triggers on row-level
END; $$;

-- Step 2: Bind trigger to table
CREATE TRIGGER trigger_name
{BEFORE | AFTER} {INSERT | UPDATE | DELETE | TRUNCATE}
ON table_name
FOR EACH {ROW | STATEMENT}
EXECUTE PROCEDURE function_name();

-- Drop trigger:
DROP TRIGGER trigger_name ON table_name;

Row vs Statement:
  FOR EACH ROW       → fires once per affected row
  FOR EACH STATEMENT → fires once per SQL statement

OLD / NEW:
  OLD → row state before UPDATE/DELETE
  NEW → row state after INSERT/UPDATE
  BEFORE trigger → can modify NEW before write

Audit trail example:
  CREATE TRIGGER last_name_changes
  BEFORE UPDATE ON employees
  FOR EACH ROW
  EXECUTE PROCEDURE log_last_name_changes();

  -- Function checks: IF NEW.last_name <> OLD.last_name THEN INSERT INTO audits...

--- VIEWS ---
-- Create:
CREATE VIEW view_name AS
SELECT ... FROM ... [WHERE ...] [JOIN ...];

-- Use:
SELECT * FROM view_name;

-- Rename:
ALTER VIEW view_name RENAME TO new_name;

-- Drop:
DROP VIEW [IF EXISTS] view_name;

-- Updatable view (no aggregates, no JOIN, no DISTINCT):
INSERT INTO view_name (col1, col2) VALUES (val1, val2);  -- inserts into base table
DELETE FROM view_name WHERE condition;                   -- deletes from base table

View benefits:
  1. Simplify complex queries
  2. Restrict data access (security)
  3. Abstraction layer (hide schema changes)

--- INDEXES ---
-- Create:
CREATE [UNIQUE] INDEX index_name ON table_name (col1 [ASC|DESC], col2);

-- Create with type:
CREATE INDEX idx_name ON table_name USING HASH (column);

-- Create without locking table:
CREATE INDEX CONCURRENTLY idx_name ON table_name (column);

-- Drop:
DROP INDEX index_name;

-- Check if index is used:
EXPLAIN SELECT * FROM table WHERE col = value;

-- UNIQUE index:
CREATE UNIQUE INDEX idx_name ON table_name (column);       -- single col
CREATE UNIQUE INDEX idx_name ON table_name (col1, col2);  -- multi-col

-- View table indexes:
SELECT tablename, indexname, indexdef FROM pg_indexes WHERE tablename = 'table_name';

Index types:
  B-tree   → default; equality, range, ORDER BY, LIKE 'prefix%'
  Hash     → only equality (=)
  GIN      → arrays, JSONB, full-text search
  BRIN     → huge tables with linear ordering (timestamps)
  GiST     → geometric, full-text
  SP-GiST  → unbalanced structures (GIS, IP routing)

NULLS in indexes:
  NULLS FIRST → NULLs before non-nulls (default when DESC)
  NULLS LAST  → NULLs after non-nulls (default when ASC)

UNIQUE + NULL: multiple NULLs are allowed (NULLs are distinct)


================================================================================
LAB 10 — PostgreSQL vs MongoDB
================================================================================

--- CREATING TABLE vs COLLECTION ---
SQL:
  CREATE TABLE people (user_id VARCHAR(30), age INT, status CHAR(1));

MongoDB:
  -- No CREATE needed; collection created on first insert

--- INSERT ---
SQL:
  INSERT INTO people(user_id, age, status) VALUES ("bcd001", 45, "A");

MongoDB:
  db.people.insertOne({ user_id: "bcd001", age: 45, status: "A" })
  db.people.insertMany([{...}, {...}])

--- SELECT / FIND ---
SQL → MongoDB:
  SELECT * FROM people                               → db.people.find()
  SELECT id, user_id, status FROM people             → db.people.find({}, {user_id:1, status:1})
  SELECT user_id, status FROM people                 → db.people.find({}, {user_id:1, status:1, _id:0})
  WHERE status = "A"                                 → { status: "A" }
  WHERE status != "A"                                → { status: { ne: "A" } }
  WHERE status="A" AND age=50                        → { status:"A", age:50 }
  WHERE age > 25                                   → { age: { gt: 25 } }
  WHERE age >= 25                                  → { age: { gte: 25 } }
  WHERE age < 25                                   → { age: { lt: 25 } }
  WHERE age <= 25                                  → { age: { lte: 25 } }
  WHERE user_id LIKE "%bc%"                          → { user_id: /bc/ }
  ORDER BY user_id ASC                               → .sort({ user_id: 1 })
  ORDER BY user_id DESC                              → .sort({ user_id: -1 })
  COUNT(*)                                         → db.people.count()
  COUNT(user_id) [non-null only]                   → db.people.count({ user_id: { exists: true } })

--- UPDATE ---
SQL:
  UPDATE people SET status="C" WHERE age > 25;
  UPDATE people SET age = age + 3 WHERE status = "A";

MongoDB:
  db.people.updateMany({ age: { gt: 25 } }, { set: { status: "C" } })
  db.people.updateMany({ status: "A" }, { inc: { age: 3 } })

Update operators:
  set   → set a field value
  inc   → increment a field by a value
  unset → remove a field

--- DELETE ---
SQL:
  DELETE FROM people WHERE status = "D";
  DELETE FROM people;

MongoDB:
  db.people.deleteMany({ status: "D" })
  db.people.deleteMany({})

--- AGGREGATION MAPPING ---
SQL              → MongoDB Operator
WHERE            → match
GROUP BY         → group
HAVING           → match (after group)
ORDER BY         → sort
SUM()            → sum
COUNT()          → sum or sortByCount
JOIN             → lookup
UNWIND array     → unwind

Aggregation pipeline structure:
  db.collection.aggregate([ stage1, stage2, ... ])

Examples:
  -- COUNT all:
  db.orders.aggregate([{ group: { _id: null, count: { sum: 1 } } }])

  -- SUM price:
  db.orders.aggregate([{ group: { _id: null, total: { sum: "price" } } }])

  -- GROUP BY cust_id, SUM, SORT:
  db.orders.aggregate([
      { group: { _id: "cust_id", total: { sum: "price" } } },
      { sort: { total: 1 } }
  ])

  -- GROUP BY two fields:
  db.orders.aggregate([{
      group: {
          _id: { cust_id: "cust_id", ord_date: { dateToString: { format: "%Y-%m-%d", date: "ord_date" } } },
          total: { sum: "price" }
      }
  }])

  -- UNWIND array then GROUP (like JOIN + SUM):
  db.orders.aggregate([
      { unwind: "items" },
      { group: { _id: "cust_id", qty: { sum: "items.qty" } } }
  ])

--- WHEN TO USE WHICH ---
Use PostgreSQL when:
  - Complex SQL queries needed
  - Strong data integrity (ACID)
  - Relational/tabular data model
  - Apps: banking, healthcare, BI reporting

Use MongoDB when:
  - Schema changes frequently (agile development)
  - Unstructured or varied data
  - Horizontal scaling required
  - Apps: content management, mobile, real-time analytics


================================================================================
QUICK REFERENCE — COMMON PATTERNS
================================================================================

-- Find duplicates:
SELECT col, COUNT(*) FROM table GROUP BY col HAVING COUNT(*) > 1;

-- Top N per group (use subquery or window functions):
SELECT * FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY group_col ORDER BY rank_col DESC) AS rn FROM table) t WHERE rn = 1;

-- Employees with above-average salary:
SELECT * FROM employees WHERE salary > (SELECT AVG(salary) FROM employees);

-- Upsert (INSERT or UPDATE):
INSERT INTO table (col1, col2) VALUES (v1, v2)
ON CONFLICT (col1) DO UPDATE SET col2 = EXCLUDED.col2;

-- COALESCE (return first non-null):
SELECT COALESCE(phone, email, 'N/A') AS contact FROM users;

-- CASE expression (inline, not statement):
SELECT name, CASE WHEN salary > 50000 THEN 'High' ELSE 'Low' END AS category FROM employees;

-- Date functions:
  DATE(timestamp)            → extract date only
  NOW()                      → current timestamp
  EXTRACT(YEAR FROM date)   → extract year
  AGE(date)                  → interval since date

-- String operations:
  first_name || ' ' || last_name   → concatenation
  UPPER(col), LOWER(col)
  LENGTH(col)
  LIKE 'prefix%'   → starts with
  LIKE '%suffix'   → ends with
  LIKE '%middle%'  → contains

-- Type casting:
  CAST(col AS INTEGER)
  col::INTEGER    -- PostgreSQL shorthand

-- LIMIT and OFFSET:
  SELECT * FROM table LIMIT 10 OFFSET 20;  -- page 3 of 10 per page

-- EXISTS vs IN:
  EXISTS → stops at first match, efficient for correlated subqueries
  IN     → evaluates all values, better for small fixed lists
  NOT IN → careful: if subquery returns NULL, entire result is NULL
  NOT EXISTS → safer than NOT IN when NULLs may appear

-- Trigger special variables:
  OLD      → row before change
  NEW      → row after change
  TG_NAME  → trigger name
  TG_OP    → operation (INSERT/UPDATE/DELETE)
  TG_TABLE_NAME → table name
